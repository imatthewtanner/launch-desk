{
  "name": "@imatthewtanner/launch-desk",
  "version": "1.0.0",
  "description": "A launch-planning agent for engineering teams.",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:live": "node scripts/verify-live-stream.mjs",
    "mcp:dev": "npm --prefix mcp-app run dev",
    "mcp:typecheck": "npm --prefix mcp-app run typecheck",
    "mcp:test": "npm --prefix mcp-app test",
    "mcp:build": "npm --prefix mcp-app run build",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "keywords": [
    "openai",
    "agents-sdk",
    "launch-planning"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@openai/agents": "^0.17.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "^16.3.2",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
